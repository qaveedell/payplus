# PostgreSQL
POSTGRES_DB=payday
POSTGRES_USER=payday
POSTGRES_PASSWORD=change-me-strong-password

# Backend
DATABASE_URL=postgres://payday:change-me-strong-password@postgres:5432/payday?sslmode=disable
JWT_SECRET=change-me-random-64-char-secret
PORT=8080
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE=5242880
CORS_ORIGINS=https://your-domain.darkube.app

# Frontend / App
APP_PORT=80
